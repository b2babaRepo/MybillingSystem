{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "grocery-khata",
    "Audience": "grocery-khata-app",
    "SigningKey": "",
    "AccessTokenMinutes": 30
  },
  "Auth": {
    "RefreshTokenDays": 90,
    "MaxFailedSignIns": 5,
    "LockoutMinutes": 15,
    "AuthRequestsPerMinutePerIp": 20
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
