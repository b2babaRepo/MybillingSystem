# Grocery Khata: HTTPS for its domain (GK_DOMAIN in the proxy's .env), then on to its web container.
{$GK_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy grocery-khata-web:80
}

# Another app later? Add a file like this one, e.g. sites/my-other-app.caddy:
#   other.example.in {
#   	reverse_proxy my-other-app-web:80
#   }
