# Grocery Khata website (the PWA) for production, served by nginx. Build from the frontend folder:
#   docker build -f deploy/production/Dockerfile.web -t grocery-khata-web frontend
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm run budget

FROM nginx:1.29-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
