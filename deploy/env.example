# Values with spaces or ; are in double quotes: this file is read by systemd and by the shell (deploy, backups).
# Copy to /etc/grocery-khata/env on the server (chmod 600, owner root). Never commit the real file.
# setup-server.sh fills every <generated> value, your admin phone and the backup lines for you.

ConnectionStrings__Default="Host=localhost;Database=grocery_khata;Username=khata_app;Password=<generated>"
Jwt__SigningKey=<generated>
Database__MigrateOnStartup=false

# Keys for Aadhaar duplicate checks and plan-bill links. Changing them later breaks duplicate checks / old bill links.
Agents__AadhaarHashKey=<generated>
Billing__BillLinkKey=<generated>

# Your own number, made platform admin (all shops) once you have signed in.
Platform__AdminPhones__0=<your mobile number>
# true: households only find shops you have approved.
Platform__HoldNewShops=true

# Where shops pay their plan (shown on My plan). Empty: shops pay the team in cash/UPI and you record it.
Billing__UpiId=
# Online payment (Razorpay). Empty: off. Webhook URL: https://<domain>/api/v1/webhooks/razorpay, event payment.captured.
Billing__RazorpayKeyId=
Billing__RazorpayKeySecret=
Billing__RazorpayWebhookSecret=
Billing__PayeeName="Grocery Khata"

# Sign-in codes by SMS (MSG91, DLT-approved OTP template). Without them, password sign-in still works.
Sms__Msg91AuthKey=
Sms__Msg91TemplateId=

# AI reading of notes and photos (Anthropic). Without it, typed notes are read by the built-in Hindi/English rules.
Ai__ApiKey=
# Voice notes (Sarvam). Without it, the microphone button is hidden.
Ai__SarvamKey=

# WhatsApp orders (Meta WhatsApp Cloud API). Without them, WhatsApp is off.
Whatsapp__AppSecret=
Whatsapp__VerifyToken=
Whatsapp__AccessToken=

# Nightly encrypted backups (filled by setup-server.sh). BACKUP_REMOTE (an rclone remote, e.g. b2:khata-backups) also
# copies each backup off the server; empty: kept on the server for 14 nights, and scripts/deploy.ps1 -FetchBackups
# brings them to your PC.
BACKUP_PGURL=
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_HEARTBEAT_URL=
